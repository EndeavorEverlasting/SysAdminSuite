      "network_intent": "InternetSync",
      "agent_runtime_may_be_required": true,
      "public_internet_may_be_required": true,
      "target_contact_allowed": false,
      "required_outputs": [
        "selected_repository_commit",
        "sealed_runtime",
        "tracked_file_sha256_seal",
        "required_package_payloads",
        "required_package_companion_files",
        "required_package_metadata",
        "operator_front_door",
        "offline_failure_continuation_logic"
      ]
    },
    "protected_execution": {
      "network_intent": "ProtectedNorthwell",
      "agent_runtime_may_be_required": false,
      "public_internet_may_be_required": false,
      "git_network_io_allowed": false,
      "public_web_lookup_allowed": false,
      "cloud_agent_provider_required": false,
      "target_contact_allowed": true,
      "execution_must_be_self_contained": true,
      "required_runtime_transport": "LOCAL_FILESYSTEM_ONLY",
      "required_properties": [
        "prepared_commit_proven",
        "tracked_file_sha256_seal_proven",
        "runtime_remotes_removed",
        "package_payload_available_locally",
        "package_companion_files_available_locally",
        "target_resolution_available_offline",
        "deployment_engine_available_offline",
        "failure_classification_available_offline",
        "same_transaction_continuation_available_offline",
        "independent_target_progress_preserved",
        "evidence_written_locally",
        "operator_recovery_available_offline"
      ]
