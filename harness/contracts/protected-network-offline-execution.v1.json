    "live_transport_owner": "scripts/SasSoftwareDeploymentAdapter.psm1",
    "exact_fqdn_required_on_protected_routes": true,
    "whatif_must_not_mutate_target": true,
    "success_requires_validation_and_teardown": true
  },
  "doctrine": {
    "agent_prepares_but_does_not_own_protected_runtime": true,
    "network_switch_is_a_runtime_boundary": true,
    "protected_network_must_assume_public_services_unavailable": true,
    "protected_execution_cannot_depend_on_chat_continuity": true,
    "protected_execution_cannot_depend_on_provider_reachability": true,
    "operator_must_not_reconstruct_inner_commands": true,
    "tracked_cmd_or_registered_front_door_required": true,
    "failure_is_a_local_continuation_state_not_a_chat_handoff": true,
    "independent_target_progress_must_be_preserved": true
