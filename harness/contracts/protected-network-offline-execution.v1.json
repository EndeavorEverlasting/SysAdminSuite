    },
    "P01": {
      "name": "Harness Infrastructure Builder",
      "canonical_repository": "EndeavorEverlasting/TokenCorridor",
      "canonical_registry_path": "src/tokencorridor/interface/promptkit/registry/base/prompts.json"
    }
