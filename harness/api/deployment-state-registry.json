{
  "schema_version": "sas-deployment-state-registry/v1",
  "repository": "EndeavorEverlasting/SysAdminSuite",
  "policy": {
    "resolve_desired_state_before_commands": true,
    "tests_are_admission_not_target_state": true,
    "transport_live_cert_is_admission_only": true,
    "fixture_proof_is_admission_only": true,
    "do_not_reinstall_verified_core_apps": true,
    "runtime_only_does_not_imply_deployment_authority": true,
    "deploy_plus_runtime_requires_apply_first": true,
    "test_autologon_with_authorized_target_means_apply_pilot": true,
    "live_cert_with_autologon_or_cybernet_apply_intent_means_deployment_chain": true,
    "autologon_deployment_requires_restart": true,
    "runtime_proof_is_not_required_for_deployment_completion": true
  },
  "contexts": [
    {
      "id": "cybernet-autologon",
      "target_profile": "cybernet",
      "target_count": 1,
      "package_sets": {
        "full_profile": "cybernet-clinical-workstation",
        "clinical_core": "cybernet-clinical-core",
        "autologon_only": "cybernet-autologon-only"
      },
      "current_product_truth": {
        "autologon_install_enabled": true,
        "canonical_system_install_enabled": false,
        "canonical_system_qualification_status": "failed_runtime_validation",
        "canonical_system_blocked_reason_contains": "did not establish AutoAdminLogon=1",
        "current_clinical_core_apply_command_id": "cybernet-core-deploy",
        "current_clinical_core_positive_status": "CLINICAL_CORE_DEPLOYMENT_COMPLETED",
        "current_full_software_apply_command_id": "cybernet-software-deploy",
        "current_full_software_positive_status": "CYBERNET_SOFTWARE_DEPLOYMENT_COMPLETED_RESTARTED",
        "current_live_apply_lane": "kerberos_s4u_named_admin_then_restart",
        "current_live_apply_command_id": "autologon-remote",
        "current_live_apply_positive_classification": "AUTOLOGON_DEPLOYMENT_RESTART_COMPLETED",
        "current_live_apply_artifact_id": "autologon-field-deployment-result",
        "internal_pre_reboot_apply_classification": "KERBEROS_S4U_AUTOLOGON_CONFIGURED_REBOOT_PROOF_PENDING",
        "operator_confirmed_profile_sources": [
          {
            "package_id": "bca",
            "source_folder_relative_path": "packages\\Epic\\EPIC_BCA_Web-Shortcut_1.0",
            "entrypoint_file": "EPIC_BCA_Web-Shortcut_1.0.msi"
          },
          {
            "package_id": "epic-downtime-guide-shortcut-1-0",
            "source_folder_relative_path": "packages\\Epic\\Epic_Epic_Downtime_Guide-Shortcut_1.0",
            "entrypoint_file": "Epic_Epic_Downtime_Guide-Shortcut_1.0.msi"
          },
          {
            "package_id": "nuance-dragon-medical-one-2025",
            "source_folder_relative_path": "packages\\Nuance_DragonMedicalOne_2025",
            "entrypoint_file": "Install.cmd"
          },
          {
            "package_id": "allscripts-eehr-shortcut-uai-2-2",
            "source_folder_relative_path": "packages\\TouchWork_22.1\\Allscripts_Shortcut",
            "entrypoint_file": "Allscripts_EEHR-Shortcut-UAI_2.2.msi"
          },
          {
            "package_id": "autologon",
            "source_folder_relative_path": "packages\\AutoLogonSetup",
            "entrypoint_file": "NW_AutoLogon_Setup_x64.exe"
          }
        ],
        "autologon_must_be_last": true,
        "autologon_restart_required": true,
        "full_profile_local_system_autologon_must_not_be_used_as_a_substitute": true
      },
      "intent_resolution": [
        {
          "id": "test-autologon",
          "signals": ["test autologon", "test auto logon", "try autologon", "pilot autologon"],
          "goal_state": "autologon_restart_completed",
          "requires_apply": true,
          "notes": "With one authorized Cybernet target and mutation authority, testing AutoLogon means executing the real S4U apply plus required restart. Fixture-only or transport-only success is insufficient."
        },
        {
          "id": "live-cert-autologon",
          "signals": ["live cert autologon", "live certification autologon", "cybernet live cert", "live cert the cybernet"],
          "goal_state": "autologon_restart_completed",
          "requires_apply": true,
          "notes": "Transport live certification is admission only. With deployment intent, the work item continues through real AutoLogon apply and target restart."
        },
        {
          "id": "deploy-autologon",
          "signals": ["deploy autologon", "apply autologon", "install autologon", "configure autologon"],
          "goal_state": "autologon_restart_completed",
          "requires_apply": true,
          "notes": "Route directly to sas autologon Remote HOST. Deployment is not complete at the pre-reboot S4U gate; the target must restart and return."
        },
        {
          "id": "deploy-software",
          "signals": ["deploy software", "deploy cybernet software", "install cybernet software", "complete cybernet software"],
          "goal_state": "cybernet_software_deployed",
          "requires_apply": true,
          "notes": "Route to sas cybernet Deploy HOST. The five clinical applications are deployed first, AutoLogon is last, and the target restart is part of completion."
        },
        {
          "id": "deploy-and-runtime-proof",
          "signals": ["deploy autologon and runtime proof", "deploy software and do runtime proof", "apply autologon and prove runtime", "live cert and runtime proof"],
          "goal_state": "autologon_runtime_proven",
          "requires_apply": true,
          "notes": "Complete the restart-required deployment first. Runtime proof is a later higher-ceiling action and must not delay deployment completion."
        },
        {
          "id": "runtime-proof-only",
          "signals": ["runtime proof", "prove autologon runtime", "prove automatic sign in"],
          "goal_state": "autologon_runtime_proven",
          "requires_apply": false,
          "requires_prior_state": "autologon_restart_completed",
          "notes": "A runtime-only request requires a correlated restart-complete deployment artifact for the same target."
        },
        {
          "id": "complete-cybernet-profile",
          "signals": ["complete cybernet profile", "finish cybernet workstation", "cybernet profile with autologon"],
          "goal_state": "cybernet_software_deployed",
          "requires_apply": true,
          "notes": "Use sas cybernet Deploy HOST for an unproven full software profile. If the five clinical applications are already proven, preserve them and use sas autologon Remote HOST. AutoLogon remains last and restart is mandatory."
        }
      ],
      "states": [
        {
          "id": "clinical_core_ready",
          "terminal": false,
          "command_id": "cybernet-core-deploy",
          "artifact_id": "cybernet-clinical-core-deployment-summary",
          "positive_classification": "CLINICAL_CORE_DEPLOYMENT_COMPLETED",
          "satisfied_by": ["existing approved deployment evidence", "existing technician/application acceptance", "explicit operator-provided installed-state evidence", "cybernet-clinical-core-deployment-summary with status CLINICAL_CORE_DEPLOYMENT_COMPLETED"],
          "on_satisfied": "skip clinical-core reinstall",
          "on_unproven": "run the clinical-core stage through sas cybernet Deploy HOST"
        },
        {
          "id": "autologon_pre_reboot_configured",
          "terminal": false,
          "command_id": "autologon-remote",
          "artifact_id": "autologon-s4u-pilot-result",
          "positive_classification": "KERBEROS_S4U_AUTOLOGON_CONFIGURED_REBOOT_PROOF_PENDING",
          "proof_ceiling": "Internal apply gate only. AutoLogon package executed and pre-reboot state is ready, but deployment is not complete until restart."
        },
        {
          "id": "autologon_restart_completed",
          "terminal": true,
          "requires_state": "autologon_pre_reboot_configured",
          "command_id": "autologon-remote",
          "artifact_id": "autologon-field-deployment-result",
          "positive_classification": "AUTOLOGON_DEPLOYMENT_RESTART_COMPLETED",
          "requires_target_mutation_authority": true,
          "requires_network": true,
          "proof_ceiling": "The outer field transaction proved protected network posture, canonical identity, exact local host eligibility, recovery convergence, apply-once admission, S4U application, and the bounded restart cycle. Direct visual automatic-sign-in observation is not claimed."
        },
        {
          "id": "cybernet_software_deployed",
          "terminal": true,
          "requires_states": ["clinical_core_ready", "autologon_restart_completed"],
          "command_id": "cybernet-software-deploy",
          "artifact_id": "cybernet-software-deployment-result",
          "positive_classification": "CYBERNET_SOFTWARE_DEPLOYMENT_COMPLETED_RESTARTED",
          "ordering": ["clinical_core_ready", "autologon_pre_reboot_configured", "autologon_restart_completed"],
          "proof_ceiling": "Five clinical applications deployed before AutoLogon, AutoLogon applied last, and required target restart cycle completed."
        },
        {
          "id": "autologon_runtime_proven",
          "terminal": true,
          "requires_state": "autologon_restart_completed",
          "requires_direct_automatic_sign_in_observation": true,
          "command_id": "autologon-runtime-proof",
          "artifact_id": "autologon-technician-runtime-proof",
          "positive_classification": "TECHNICIAN_OBSERVED_LIVE_RUNTIME",
          "proof_ceiling": "Optional higher-ceiling proof from the actual AutoLogon desktop. It is not required for deployment completion."
        }
      ],
      "critical_artifact_chain": [
        {"artifact_id":"cybernet-clinical-core-deployment-summary","required_value":"status=CLINICAL_CORE_DEPLOYMENT_COMPLETED","proves_state":"clinical_core_ready"},
        {"artifact_id":"autologon-s4u-pilot-result","required_value":"classification=KERBEROS_S4U_AUTOLOGON_CONFIGURED_REBOOT_PROOF_PENDING","proves_state":"autologon_pre_reboot_configured"},
        {"artifact_id":"autologon-field-deployment-result","required_value":"status=COMPLETED and classification=AUTOLOGON_DEPLOYMENT_RESTART_COMPLETED and host_eligibility_proven=true and automatic_reboot_performed=true and restart_offline_observed=true and restart_online_observed=true and restart_task_cleanup_verified=true","proves_state":"autologon_restart_completed"},
        {"artifact_id":"cybernet-software-deployment-result","required_value":"status=CYBERNET_SOFTWARE_DEPLOYMENT_COMPLETED_RESTARTED and autologon_was_last_software_step=true and automatic_reboot_performed=true","proves_state":"cybernet_software_deployed"},
        {"artifact_id":"autologon-technician-runtime-proof","required_value":"proof_level=TECHNICIAN_OBSERVED_LIVE_RUNTIME and runtime_proof=true and overall_success=true","proves_state":"autologon_runtime_proven"}
      ],
      "forbidden_substitutions": [
        "deployment_planned",
        "FIXTURE_PASS",
        "KERBEROS_S4U_FIXTURE_READY",
        "LIVE CERT PASS transport-only result",
        "KERBEROS_S4U_AUTOLOGON_CONFIGURED_REBOOT_PROOF_PENDING as final deployment completion",
        "installer exit code 0 or 3010 by itself",
        "process started",
        "command acknowledgement",
        "runtime proof as a prerequisite that delays deployment",
        "six-package LocalSystem Cybernet apply as a substitute for the current clinical-core plus S4U AutoLogon lanes"
      ]
    }
  ]
}
