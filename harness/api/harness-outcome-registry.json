{
  "schema_version": "sas-harness-outcome-registry/v1",
  "repository": "EndeavorEverlasting/SysAdminSuite",
  "policy": {
    "requested_goal_required": true,
    "validation_is_admission_not_completion": true,
    "dry_run_must_emit_artifact": true,
    "same_turn_continuation_required": "When the requested goal remains unproven and the next registered command is safe, authorized, and dependency-satisfied, execute it in the same agent turn instead of handing the command back to the operator.",
    "allowed_terminal_outcomes": [
      "artifact_created",
      "build_artifact_created",
      "runtime_started",
      "product_deployed",
      "runtime_proven",
      "blocked_with_actionable_gate"
    ],
    "forbidden_terminal_outcomes": [
      "tests_passed_only",
      "status_reported_only",
      "command_printed_only",
      "wait_for_next_chat",
      "operator_repeats_agent_work"
    ]
  },
  "contracts": [
    {
      "command_id": "harness-validate",
      "success_outcome": "artifact_created",
      "success_artifact_id": "harness-registry-validation-result",
      "terminal_goals": ["validate", "artifact"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "harness-outcome-validate",
      "success_outcome": "artifact_created",
      "success_artifact_id": "harness-outcome-validation-result",
      "terminal_goals": ["validate", "artifact"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "deployment-state-validate",
      "success_outcome": "artifact_created",
      "success_artifact_id": "deployment-state-validation-result",
      "terminal_goals": ["validate", "artifact"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "harness-completeness",
      "success_outcome": "artifact_created",
      "success_artifact_id": "harness-completeness-result",
      "terminal_goals": ["validate", "artifact"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "offline-floor",
      "success_outcome": "artifact_created",
      "success_artifact_id": "offline-survey-floor-result",
      "terminal_goals": ["validate", "artifact"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "powershell-tests",
      "success_outcome": "artifact_created",
      "success_artifact_id": "pester-suite-result",
      "terminal_goals": ["validate", "artifact"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "managed-tests",
      "success_outcome": "artifact_created",
      "success_artifact_id": "managed-tests-result",
      "terminal_goals": ["validate", "artifact"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "dashboard-build",
      "success_outcome": "build_artifact_created",
      "success_artifact_id": "dashboard-publish-output",
      "terminal_goals": ["build", "artifact"],
      "continuations": [
        {
          "when_goal": "run",
          "command_id": "dashboard-launch",
          "same_turn": true,
          "requires_authorization": false,
          "dependency": "dashboard publish output exists"
        }
      ],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "dashboard-launch",
      "success_outcome": "runtime_started",
      "success_artifact_id": null,
      "terminal_goals": ["run"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "cybernet-plan",
      "success_outcome": "artifact_created",
      "success_artifact_id": "cybernet-client-configuration-summary",
      "terminal_goals": ["plan", "artifact"],
      "continuations": [
        {
          "when_goal": "deploy",
          "command_id": "cybernet-apply",
          "same_turn": true,
          "requires_authorization": true,
          "dependency": "plan summary is PLAN_READY and explicit target mutation authorization exists"
        }
      ],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "cybernet-apply",
      "success_outcome": "product_deployed",
      "success_artifact_id": "cybernet-client-configuration-summary",
      "terminal_goals": ["deploy"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "autologon-remote",
      "success_outcome": "product_deployed",
      "success_artifact_id": "autologon-s4u-pilot-result",
      "terminal_goals": ["deploy", "pre-reboot-proof"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    },
    {
      "command_id": "autologon-runtime-proof",
      "success_outcome": "runtime_proven",
      "success_artifact_id": "autologon-technician-runtime-proof",
      "terminal_goals": ["runtime-proof", "acceptance"],
      "continuations": [],
      "failure_outcome": "blocked_with_actionable_gate"
    }
  ]
}
