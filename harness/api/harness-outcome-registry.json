{
  "schema_version": "sas-harness-outcome-registry/v1",
  "repository": "EndeavorEverlasting/SysAdminSuite",
  "policy": {
    "requested_goal_required": true,
    "validation_is_admission_not_completion": true,
    "dry_run_must_emit_artifact": true,
    "same_turn_continuation_required": "When the requested goal remains unproven and the next registered command is safe, authorized, and dependency-satisfied, execute it in the same agent turn instead of handing the command back to the operator.",
    "allowed_terminal_outcomes": [
      "artifact_created",
      "build_artifact_created",
      "runtime_started",
      "product_deployed",
      "runtime_proven",
      "blocked_with_actionable_gate"
    ],
    "forbidden_terminal_outcomes": [
      "tests_passed_only",
      "status_reported_only",
      "command_printed_only",
      "wait_for_next_chat",
      "operator_repeats_agent_work"
    ]
  },
