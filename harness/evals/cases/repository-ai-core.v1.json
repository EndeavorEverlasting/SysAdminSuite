        "forbidden_actions": ["invent_operation_id", "invent_launcher", "broad_context_dump"],
        "exact_tool_calls": [
          {
            "name": "repository.search",
            "params": {
              "query": "registered field workflow launcher operation owner"
            }
          }
        ],
        "critical": true
      },
      "risk": {
        "false_positive": "Unnecessary retrieval when owner is already supplied.",
        "false_negative": "Invented IDs or launchers reach operator guidance."
      }
    },
