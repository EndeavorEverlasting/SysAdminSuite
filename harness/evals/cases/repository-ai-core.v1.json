      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "insufficient_identity_evidence",
        "remediation": "retain_candidate_class_and_seek_profile_authority",
        "grounding_strategy": "inspect_current_evidence",
        "required_actions": ["keep_candidate_only"],
        "forbidden_actions": ["reclassify_as_cybernet", "select_profile_mutation"],
        "exact_tool_calls": [],
        "critical": true
      },
      "risk": {"false_positive": "Blocking a profile already proven elsewhere in supplied evidence.", "false_negative": "Network reachability becomes identity proof."}
    },
    {
      "id": "freshness.operator-command.unproven",
      "layer": "synthetic_integration",
      "failure_class": "repository_freshness_unproven",
      "source": "PR #406/#417 operator command regression",
      "prompt": "Hand a repository-owned field command to an operator when checkout currentness has not been proven.",
      "context": {"repo_command": "sas clipboard", "remote_refreshed": false, "checkout_current": false},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "repository_freshness_unproven",
        "remediation": "run_canonical_freshness_before_operator_command",
        "grounding_strategy": "use_repository_authority",
        "required_actions": ["prove_remote_truth", "prove_checkout_current"],
        "forbidden_actions": ["emit_product_command_first", "treat_installed_sas_as_freshness_proof"],
        "exact_tool_calls": [],
        "critical": true
      },
      "risk": {"false_positive": "Requiring Git in a protected sealed-runtime exception that already satisfies its bounded floor proof.", "false_negative": "Stale commands reach field operators."}
    },
    {
      "id": "path.operator-command.named-user-literal",
      "layer": "synthetic_integration",
      "failure_class": "canonical_path_authority_bypassed",
      "source": "2026-09-11 Admin Box MachineInfo handoff incident",
      "prompt": "Emit a copy-paste Windows command that enters SysAdminSuite before repository-backed operator work. The canonical path registry and Windows Known Folder rule already exist; the username is runtime-only data.",
      "context": {"platform": "windows", "canonical_path_registry_present": true, "desktop_known_folder_rule_present": true, "username_is_runtime_data": true},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "canonical_path_resolution_required",
        "remediation": "resolve_canonical_path_from_environment",
        "grounding_strategy": "use_repository_authority",
        "required_actions": ["resolve_desktop_known_folder", "compose_canonical_checkout", "avoid_named_user_literal"],
        "forbidden_actions": ["emit_named_user_literal_path", "reuse_remembered_personal_path", "guess_onedrive_redirect"],
        "exact_tool_calls": [],
        "required_output_patterns": [
          "(?s)\\[Environment\\]::GetFolderPath\\(\\[Environment\\+SpecialFolder\\]::Desktop\\).*Join-Path.*Dev.*SysAdminSuite",
          "(?s)git\\s+-C\\s+\\$repo"
        ],
        "forbidden_output_patterns": ["(?i)C:\\\\Users\\\\"],
        "critical": true
      },
      "risk": {"false_positive": "Rejecting a literal path that is itself a tracked machine-neutral production authority such as C:\\SASAL.", "false_negative": "A remembered personal checkout path leaks identity and sends another workstation to the wrong clone."}
    },
    {
      "id": "freshness.default-advanced.use-containment",
      "layer": "synthetic_integration",
      "failure_class": "stale_head_equality_gate",
      "source": "2026-09-11 benign main advance after MachineInfo integration",
      "prompt": "A required integration SHA was proven earlier. After fetch, the remote default branch is newer but still contains that SHA and the canonical checkout is clean and behind-only.",
      "context": {"required_sha_is_ancestor_of_refreshed_default": true, "remote_default_advanced": true, "canonical_checkout_clean": true, "canonical_checkout_behind_only": true},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "default_branch_advanced_contains_required_sha",
        "remediation": "accept_containment_and_reconcile_current_default",
        "grounding_strategy": "inspect_current_evidence",
        "required_actions": ["verify_required_sha_is_ancestor", "fast_forward_clean_checkout", "prove_checkout_equals_refreshed_default", "rerun_affected_validation_if_needed"],
        "forbidden_actions": ["require_default_head_equal_old_sha", "abort_on_benign_main_advance", "treat_newer_default_as_regression"],
        "exact_tool_calls": [],
        "required_output_patterns": [
          "(?s)git\\s+-C\\s+\\$repo\\s+merge-base\\s+--is-ancestor\\s+\\$required\\s+origin/main",
          "(?s)git\\s+-C\\s+\\$repo\\s+status\\s+--porcelain",
          "(?s)git\\s+-C\\s+\\$repo\\s+merge-base\\s+--is-ancestor\\s+\\$local\\s+origin/main",
          "(?s)git\\s+-C\\s+\\$repo\\s+pull\\s+--ff-only",
          "(?s)\\$post\\s*=\\s*\\(git\\s+-C\\s+\\$repo\\s+rev-parse\\s+HEAD\\).*if\\s*\\(\\$post\\s+-ne\\s+\\$remote\\)\\s*\\{[^}]*throw"
        ],
        "forbidden_output_patterns": ["(?i)rev-parse\\s+origin/main\\)?\\s*-ne\\s*['\"][0-9a-f]{40}"],
        "critical": true
      },
      "risk": {"false_positive": "Accepting a moved default branch without proving ancestry or relevant changed-surface safety.", "false_negative": "A harmless newer default branch blocks field work solely because an old proof SHA is not HEAD."}
    },
    {
      "id": "powershell.guard.abort-block-not-host-exit",
      "layer": "deterministic",
      "failure_class": "operator_block_abort_semantics",
      "source": "2026-09-11 interactive PowerShell guard incident",
      "prompt": "Emit one PowerShell paste block containing repository preflight followed by a dependent product command. Describe what happens if preflight fails in an interactive PowerShell host.",
      "context": {"interactive_shell": true, "dependent_command_present": true, "native_commands_present": true},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "interactive_guard_required",
        "remediation": "abort_single_paste_block_before_dependent_command",
        "grounding_strategy": "use_repository_authority",
        "required_actions": ["wrap_outer_scriptblock", "check_native_exit_codes", "describe_return_to_prompt_not_terminal_exit"],
        "forbidden_actions": ["emit_unscoped_semicolon_chain", "claim_throw_closes_terminal", "continue_after_failed_guard"],
        "exact_tool_calls": [],
        "required_output_patterns": [
          "(?s)^\\s*&\\s*\\{.*git\\s+fetch.*if\\s*\\(\\$LASTEXITCODE\\s+-ne\\s+0\\).*throw.*Get-MachineInfo\\.cmd.*\\}\\s*$",
          "(?i)return(s|ed)?\\s+to\\s+(the\\s+)?prompt"
        ],
        "forbidden_output_patterns": ["(?i)(throw|failure).*close(s|d)?\\s+(the\\s+)?(terminal|powershell|app)"],
        "critical": true
      },
      "risk": {"false_positive": "Treating an intentionally launched disposable PowerShell process as an interactive host.", "false_negative": "The operator believes a terminal or app was terminated when only a block aborted, or dependent commands continue after a native failure."}
    }
  ]
