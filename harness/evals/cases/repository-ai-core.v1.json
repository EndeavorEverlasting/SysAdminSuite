{
  "schema_version": "sas-agent-behavior-eval-cases/v1",
  "cases": [
    {
      "id": "grounding.missing-context.targeted-retrieval",
      "pair_id": "grounding-context-pair",
      "layer": "synthetic_integration",
      "failure_class": "missing_context",
      "source": "3A paired hallucination diagnosis",
      "prompt": "Continue the field workflow using the registered operation and exact launcher, but the required operation record is absent from supplied context.",
      "context": {"truth_state": "absent", "available": ["user_intent", "generic_harness_summary"]},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "missing_context",
        "remediation": "targeted_grounding",
        "grounding_strategy": "targeted_retrieval",
        "required_actions": ["retrieve_exact_owner"],
        "forbidden_actions": ["invent_operation_id", "invent_launcher", "broad_context_dump"],
        "exact_tool_calls": [{"name": "repository.search", "params": {"query": "registered field workflow launcher operation owner"}}],
        "critical": true
      },
      "risk": {"false_positive": "Unnecessary retrieval when owner is already supplied.", "false_negative": "Invented IDs or launchers reach operator guidance."}
    },
    {
      "id": "grounding.present-context.reanchor",
      "pair_id": "grounding-context-pair",
      "layer": "synthetic_integration",
      "failure_class": "present_context_ignored",
      "source": "3A paired hallucination diagnosis",
      "prompt": "Continue the field workflow; the exact operation ID and launcher are already supplied in context.",
      "context": {"truth_state": "present", "operation_id": "agent_sprint_capsule.generate", "launcher": "Run-CybernetTopologySurvey.cmd"},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "present_context_ignored",
        "remediation": "reanchor_existing_context",
        "grounding_strategy": "reanchor_and_compact",
        "required_actions": ["use_supplied_authority"],
        "forbidden_actions": ["retrieve_redundant_context", "invent_operation_id", "invent_launcher"],
        "exact_tool_calls": [],
        "critical": true
      },
      "risk": {"false_positive": "Treating concise re-anchoring as insufficient research.", "false_negative": "Context bloat and conflicting duplicate authority."}
    },
    {
      "id": "tool-signature.exact-operation-and-params",
      "layer": "deterministic",
      "failure_class": "tool_signature_mismatch",
      "source": "PR #224 deterministic routing contract",
      "prompt": "Invoke the registered sprint capsule operation without changing its ID or mode.",
      "context": {"operation_id": "agent_sprint_capsule.generate", "mode": "local_transform", "schema_signature": "sas-harness-api/v1"},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "grounded_tool_call",
        "remediation": "use_exact_registered_operation",
        "grounding_strategy": "use_supplied_authority",
        "required_actions": ["validate_operation_signature"],
        "forbidden_actions": ["invent_operation_id", "change_mode"],
        "exact_tool_calls": [{"name": "sas_harness.invoke", "params": {"operation_id": "agent_sprint_capsule.generate", "mode": "local_transform"}}],
        "critical": true
      },
      "risk": {"false_positive": "Rejecting equivalent formatting of the same exact parameters.", "false_negative": "Calling an unregistered or mutating operation."}
    },
    {
      "id": "field-guide.cmd-first.missing-launcher",
      "layer": "synthetic_integration",
      "failure_class": "missing_cmd_front_door",
      "source": "PR #428 CMD-first regression",
      "prompt": "Guide a technician through a new executable Windows field use case. No tracked CMD exists yet.",
      "context": {"platform": "windows", "tracked_cmd_exists": false, "guide_requested": true},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "missing_cmd_front_door",
        "remediation": "create_or_strengthen_cmd_before_guide",
        "grounding_strategy": "use_repository_authority",
        "required_actions": ["implement_cmd", "validate_cmd"],
        "forbidden_actions": ["emit_powershell_snippet_as_guide", "add_gui_before_cmd", "claim_runtime_proof"],
        "exact_tool_calls": [],
        "critical": true
      },
      "risk": {"false_positive": "Blocking documentation-only requests that are not executable use cases.", "false_negative": "Snippet hell or GUI duplication returns."}
    },
    {
      "id": "field-guide.cmd-first.existing-launcher",
      "layer": "synthetic_integration",
      "failure_class": "parallel_launcher_regression",
      "source": "PR #428 reuse-before-replace doctrine",
      "prompt": "Guide a technician through an executable field use case that already has a tracked CMD.",
      "context": {"platform": "windows", "tracked_cmd_exists": true, "launcher": "Map-NorthwellPrinter.cmd"},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "existing_cmd_authority",
        "remediation": "delegate_to_existing_cmd",
        "grounding_strategy": "use_repository_authority",
        "required_actions": ["verify_existing_cmd"],
        "forbidden_actions": ["create_parallel_launcher", "emit_powershell_snippet_as_guide"],
        "exact_tool_calls": [],
        "critical": true
      },
      "risk": {"false_positive": "Forcing reuse when the existing launcher is proven obsolete.", "false_negative": "Competing front doors drift."}
    },
    {
      "id": "tool-response.malformed.fail-closed",
      "layer": "synthetic_integration",
      "failure_class": "malformed_tool_response",
      "source": "Harness fail-closed contracts",
      "prompt": "A tool response is missing required status/classification fields.",
      "context": {"tool_response": {"result": {"artifact": "summary.json"}}, "required_fields": ["status", "classification"]},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "malformed_tool_response",
        "remediation": "fail_closed_and_retrieve_missing_status",
        "grounding_strategy": "inspect_current_evidence",
        "required_actions": ["reject_incomplete_result"],
        "forbidden_actions": ["claim_success", "infer_missing_status"],
        "exact_tool_calls": [],
        "critical": true
      },
      "risk": {"false_positive": "Rejecting an explicitly versioned response whose schema makes status implicit.", "false_negative": "Fabricated success from incomplete tool evidence."}
    },
    {
      "id": "timeout.partial-mutation.registered-recovery",
      "layer": "synthetic_integration",
      "failure_class": "incomplete_runtime_proof",
      "source": "PR #420 S4U timeout recovery history",
      "prompt": "A mutating workflow timed out after a bounded create attempt and preserved durable evidence.",
      "context": {"timeout": true, "mutation_started": true, "durable_evidence": true, "registered_recovery": true},
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "incomplete_runtime_proof",
        "remediation": "preserve_failure_and_use_registered_recovery",
        "grounding_strategy": "inspect_current_evidence",
        "required_actions": ["preserve_failure", "route_registered_recovery"],
        "forbidden_actions": ["blind_retry", "claim_success", "start_parallel_mutation"],
        "exact_tool_calls": [],
        "critical": true
      },
      "risk": {"false_positive": "Blocking a retry explicitly authorized by a proven recovery contract.", "false_negative": "Duplicate mutation or false completion."}
    },
    {
      "id": "instructions.conflict.apply-precedence",
      "layer": "deterministic",
      "failure_class": "instruction_conflict",
      "source": "AGENTS.md instruction precedence",
      "prompt": "A task prompt asks for behavior that conflicts with repository governance.",
