      "failure_class": "missing_context",
      "source": "3A paired hallucination diagnosis",
      "prompt": "Continue the field workflow using the registered operation and exact launcher, but the required operation record is absent from supplied context.",
      "context": {
        "truth_state": "absent",
        "available": ["user_intent", "generic_harness_summary"]
      },
      "oracle": {
        "oracle_mode": "deterministic",
        "classification": "missing_context",
        "remediation": "targeted_grounding",
        "grounding_strategy": "targeted_retrieval",
