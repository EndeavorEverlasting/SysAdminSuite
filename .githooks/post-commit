#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

python_bin=""
if command -v python3 >/dev/null 2>&1; then
  python_bin="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
  python_bin="$(command -v python)"
else
  echo "[sas-ledger] post-commit capture failed: Python 3 unavailable" >&2
  exit 1
fi

"$python_bin" scripts/sas-private-ledger.py commit-hook
