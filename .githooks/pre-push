#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
remote_name="${1:-origin}"
cd "$repo_root"

echo "[sas-harness] pre-push: running offline survey guardrails"
python3 harness/validators/validate-harness-registries.py
python3 harness/validators/validate-operator-command-handoff.py
python3 Tests/survey/test_operator_command_handoff_contracts.py
python3 harness/validators/validate-outcome-contracts.py
python3 harness/validators/validate-deployment-state-contracts.py
python3 harness/validators/validate-terminal-evidence-survival.py
python3 harness/validators/validate-printer-mapping-use-cases.py
python3 harness/validators/validate-cybernet-hardware-identity.py
python3 Tests/survey/test_cybernet_hardware_identity_harness_completeness.py
bash tests/survey/run_offline_survey_tests.sh
python3 Tests/survey/test_operational_harness_completeness_contracts.py
python3 Tests/survey/test_local_harness_contracts.py
python3 Tests/survey/test_sprint_working_rules_contracts.py

validation_roots=()
cleanup_validation_worktrees() {
  local root wt
  for root in "${validation_roots[@]:-}"; do
    [[ -n "$root" ]] || continue
    wt="$root/worktree"
    if [[ -d "$wt" ]]; then
      git worktree remove --force "$wt" >/dev/null 2>&1 || true
    fi
    rm -rf "$root"
  done
}
trap cleanup_validation_worktrees EXIT HUP INT TERM

declare -A pushed_tip_checked=()

# Stable freshness hook API retained for existing contracts; the broadened pushed-tip validator
# below executes freshness, canonical-path, composed operator-handoff, and operator-route validation
# from the same immutable snapshot.
validate_freshness_tip() {
  validate_pushed_tip "$@"
}

validate_pushed_tip() {
  local commit="$1"
  [[ "$(git cat-file -t "$commit" 2>/dev/null || true)" == "commit" ]] || return 0
  [[ -z "${pushed_tip_checked[$commit]+x}" ]] || return 0
  pushed_tip_checked[$commit]=1

  local has_freshness=0
  local has_canonical_path=0
  local has_operator_handoff=0
  local has_operator_route=0
  if git cat-file -e "$commit:harness/validators/validate-repository-freshness-contracts.py" 2>/dev/null; then
    has_freshness=1
  fi
  if git cat-file -e "$commit:harness/validators/validate-canonical-path-contracts.py" 2>/dev/null; then
    has_canonical_path=1
  fi
  if git cat-file -e "$commit:harness/validators/validate-operator-command-handoff.py" 2>/dev/null; then
    has_operator_handoff=1
  fi
  if git cat-file -e "$commit:harness/validators/validate-operator-execution-route.py" 2>/dev/null; then
    has_operator_route=1
  fi
  if [[ "$has_freshness" -eq 0 && "$has_canonical_path" -eq 0 && "$has_operator_handoff" -eq 0 && "$has_operator_route" -eq 0 ]]; then
    return 0
  fi

  # Validate snapshot-sensitive contracts from the exact pushed tip so dirty local files cannot mask failures
  # and unstaged changes cannot block a valid pushed commit.
  local root wt
  root="$(mktemp -d "${TMPDIR:-/tmp}/sas-harness-push.XXXXXX")"
  validation_roots+=("$root")
  wt="$root/worktree"
  git worktree add --detach --quiet "$wt" "$commit"
  (
    cd "$wt"
    if [[ "$has_freshness" -eq 1 ]]; then
      python3 harness/validators/validate-repository-freshness-contracts.py
    fi
    if [[ "$has_canonical_path" -eq 1 ]]; then
      python3 harness/validators/validate-canonical-path-contracts.py
      python3 Tests/survey/test_canonical_path_harness_completeness.py
    fi
    if [[ "$has_operator_handoff" -eq 1 ]]; then
      python3 harness/validators/validate-operator-command-handoff.py
      python3 Tests/survey/test_operator_command_handoff_contracts.py
    fi
    if [[ "$has_operator_route" -eq 1 ]]; then
      python3 harness/validators/validate-operator-execution-route.py
    fi
  )
  git worktree remove --force "$wt" >/dev/null
  rm -rf "$root"
}

checked_commit=0
saw_ref_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_sha:-}" ]] || continue
  saw_ref_update=1

  # A zero local SHA deletes the destination ref and carries no new commit content.
  [[ "$local_sha" =~ ^0+$ ]] && continue

  validate_freshness_tip "$local_sha"

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New destination ref: validate commits not already present on this destination remote.
    mapfile -t destination_refs < <(
      git for-each-ref --format='%(refname)' "refs/remotes/${remote_name}/"
    )
    if [[ "${#destination_refs[@]}" -gt 0 ]]; then
      rev_list=("$local_sha" --not "${destination_refs[@]}")
    else
      rev_list=("$local_sha")
    fi
  else
    # Existing destination ref: validate exactly the commits the push adds there.
    rev_list=("${remote_sha}..${local_sha}")
  fi

  while read -r commit; do
    [[ -n "$commit" ]] || continue
    python3 scripts/check-repo-text-policy.py --commit "$commit"
    checked_commit=1
  done < <(git rev-list "${rev_list[@]}")
done

# Manual hook invocation has no ref-update input; validate the current commit.
if [[ "$saw_ref_update" -eq 0 ]]; then
  validate_freshness_tip HEAD
fi
if [[ "$saw_ref_update" -eq 0 && "$checked_commit" -eq 0 ]]; then
  python3 scripts/check-repo-text-policy.py --commit HEAD
fi

echo "[sas-harness] pre-push: ok"
