{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sysadminsuite/rework-prevention-registry.schema.json",
  "title": "SysAdminSuite Rework Prevention Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "policy", "controls", "known_failure_patterns"],
  "properties": {
    "schema_version": {"const": "sas-rework-prevention-registry/v1"},
    "repository": {"const": "EndeavorEverlasting/SysAdminSuite"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_before_retry",
        "shell_is_metadata_only",
        "network_context_must_be_explicit",
        "source_validation_before_target_mutation",
        "unresolved_previous_run_blocks_retry",
        "cleanup_requires_positive_evidence",
        "narrow_validation_before_broad_suites",
        "forbidden_retry_patterns"
      ],
      "properties": {
        "evidence_before_retry": {"const": true},
        "shell_is_metadata_only": {"const": true},
        "network_context_must_be_explicit": {"const": true},
        "source_validation_before_target_mutation": {"const": true},
        "unresolved_previous_run_blocks_retry": {"const": true},
        "cleanup_requires_positive_evidence": {"const": true},
        "narrow_validation_before_broad_suites": {"const": true},
        "forbidden_retry_patterns": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "required_behavior", "forbidden_behavior", "proof_artifact", "validation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "trigger": {"type": "string", "minLength": 8},
          "required_behavior": {"type": "string", "minLength": 20},
          "forbidden_behavior": {"type": "string", "minLength": 12},
          "proof_artifact": {"type": "string", "minLength": 3},
          "validation": {"const": "rework-prevention-contracts"}
        }
      }
    },
    "known_failure_patterns": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "signal", "prevention_controls"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "signal": {"type": "string", "minLength": 12},
          "prevention_controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          }
        }
      }
    }
  }
}
