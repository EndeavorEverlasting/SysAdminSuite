{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadminsuite.invalid/schemas/harness/harness-artifact-registry.schema.json",
  "title": "SysAdminSuite harness artifact registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "naming", "artifacts"],
  "properties": {
    "schema_version": {"const": "sas-harness-artifact-registry/v1"},
    "repository": {"const": "EndeavorEverlasting/SysAdminSuite"},
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "generated_root", "tracked_documents"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "generated_root": {"type": "string", "minLength": 1},
        "tracked_documents": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "generator", "format", "tracked", "contains_live_data", "purpose"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "path": {"type": "string", "minLength": 1},
          "generator": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "tracked": {"type": "boolean"},
          "contains_live_data": {
            "oneOf": [
              {"type": "boolean"},
              {"const": "workflow-dependent"}
            ]
          },
          "parser_facing": {"type": "boolean"},
          "consumption": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 8}
        }
      }
    }
  }
}
