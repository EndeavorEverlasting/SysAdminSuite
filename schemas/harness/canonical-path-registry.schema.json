{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadminsuite.invalid/schemas/harness/canonical-path-registry.schema.json",
  "title": "SysAdminSuite canonical path registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "default_profile", "policy", "proof_states", "profiles", "consumers", "operator_command_safety", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "sas-canonical-path-registry/v1"},
    "repository": {"const": "EndeavorEverlasting/SysAdminSuite"},
    "default_profile": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_main_contains_sha_is_not_workstation_deployment_proof",
        "canonical_development_checkout_must_be_unique",
        "second_mutable_clone_is_forbidden",
        "preserve_unique_or_dirty_work",
        "parallel_writers_use_isolated_worktrees",
        "ephemeral_acquisition_checkout_never_becomes_canonical_by_existence",
        "production_use_path_requires_independent_currentness_proof",
        "operator_entrypoint_requires_independent_observation_proof"
      ],
      "properties": {
        "remote_main_contains_sha_is_not_workstation_deployment_proof": {"const": true},
        "canonical_development_checkout_must_be_unique": {"const": true},
        "second_mutable_clone_is_forbidden": {"const": true},
        "preserve_unique_or_dirty_work": {"const": true},
        "parallel_writers_use_isolated_worktrees": {"const": true},
        "ephemeral_acquisition_checkout_never_becomes_canonical_by_existence": {"const": true},
        "production_use_path_requires_independent_currentness_proof": {"const": true},
        "operator_entrypoint_requires_independent_observation_proof": {"const": true}
      }
    },
    "proof_states": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "proves", "does_not_prove"],
        "properties": {
          "id": {"enum": ["remote_default_contains_sha", "canonical_development_checkout_current", "production_use_path_current", "operator_entrypoint_observes_current"]},
          "proves": {"type": "string", "minLength": 12},
          "does_not_prove": {"type": "string", "minLength": 12}
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "purpose", "canonical_development_checkout", "production_use_path", "temporary_worktree_root", "ephemeral_acquisition_patterns", "real_operator_entrypoint"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "platform": {"enum": ["windows", "linux", "macos", "cross-platform"]},
          "purpose": {"type": "string", "minLength": 8},
          "canonical_development_checkout": {"$ref": "#/$defs/pathRecord"},
          "production_use_path": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["applicable", "reason"],
                "properties": {"applicable": {"const": false}, "reason": {"type": "string", "minLength": 8}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["applicable", "template", "mutable", "purpose", "currentness"],
                "properties": {
                  "applicable": {"const": true},
                  "template": {"type": "string", "minLength": 2},
                  "mutable": {"type": "boolean"},
                  "purpose": {"type": "string", "minLength": 8},
                  "currentness": {"type": "string", "minLength": 8}
                }
              }
            ]
          },
          "temporary_worktree_root": {"$ref": "#/$defs/pathRecord"},
          "ephemeral_acquisition_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "real_operator_entrypoint": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string"}}
        }
      }
    },
    "consumers": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}},
    "operator_command_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["powershell_if_else_must_be_one_paste_block", "reason"],
      "properties": {
        "powershell_if_else_must_be_one_paste_block": {"const": true},
        "reason": {"type": "string", "minLength": 16}
      }
    },
    "proof_ceiling": {"type": "string", "minLength": 24}
  },
  "$defs": {
    "pathRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "mutable", "purpose"],
      "properties": {
        "template": {"type": "string", "minLength": 2},
        "mutable": {"type": "boolean"},
        "purpose": {"type": "string", "minLength": 8},
        "authority": {"type": "string", "minLength": 3},
        "currentness": {"type": "string", "minLength": 8}
      }
    }
  }
}
