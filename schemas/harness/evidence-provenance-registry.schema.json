{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadminsuite.invalid/schemas/harness/evidence-provenance-registry.schema.json",
  "title": "SysAdminSuite evidence provenance registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "policy",
    "artifact_provenance_states",
    "discriminator_states",
    "freshness_classes",
    "reuse_conditions",
    "invalidation_reasons",
    "restage_rule",
    "allowed_restage_reasons",
    "bindings",
    "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "sas-evidence-provenance-registry/v1"},
    "repository": {"const": "EndeavorEverlasting/SysAdminSuite"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_original_run_identity",
        "prior_provenance_may_satisfy_discriminator",
        "missing_current_duplicate_is_not_invalidation",
        "conflicts_require_resolution",
        "no_restage_without_invalidation_reason",
        "live_evidence_remains_untracked"
      ],
      "properties": {
        "preserve_original_run_identity": {"const": true},
        "prior_provenance_may_satisfy_discriminator": {"const": true},
        "missing_current_duplicate_is_not_invalidation": {"const": true},
        "conflicts_require_resolution": {"const": true},
        "no_restage_without_invalidation_reason": {"const": true},
        "live_evidence_remains_untracked": {"const": true}
      }
    },
    "artifact_provenance_states": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["CURRENT_RUN", "PRIOR_RUN", "MISSING", "INVALID", "SUPERSEDED"]
      }
    },
    "discriminator_states": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SATISFIED_CURRENT_RUN",
          "SATISFIED_BY_PRIOR_PROVENANCE",
          "UNSATISFIED",
          "STALE_REVALIDATION_REQUIRED",
          "CONFLICT",
          "NOT_APPLICABLE"
        ]
      }
    },
    "freshness_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reuse", "description"],
        "properties": {
          "id": {"enum": ["STABLE", "CONFIGURATION_SENSITIVE", "VOLATILE", "WINDOW_COUPLED"]},
          "reuse": {"type": "string", "minLength": 8},
          "description": {"type": "string", "minLength": 16}
        }
      }
    },
    "reuse_conditions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "enum": [
              "IDENTITY_COMPATIBILITY",
              "QUESTION_COMPATIBILITY",
              "EVIDENCE_INTEGRITY",
              "NO_INVALIDATING_CHANGE",
              "FRESHNESS_SEMANTICS",
              "NO_CONFLICT"
            ]
          },
          "description": {"type": "string", "minLength": 16}
        }
      }
    },
    "invalidation_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "READER_IDENTITY_INCOMPATIBLE",
          "RELEVANT_SOFTWARE_STATE_CHANGED",
          "RELEVANT_NETWORK_STATE_CHANGED",
          "RELEVANT_STATE_CHANGE_SUSPECTED",
          "PRIOR_EVIDENCE_INCOMPLETE",
          "NEWER_EVIDENCE_CONFLICT",
          "FRESHNESS_POLICY_EXHAUSTED",
          "SAME_WINDOW_TEMPORAL_COMPARISON_REQUIRED",
          "QUESTION_NOT_ANSWERED_BY_PRIOR_EVIDENCE",
          "NO_ARTIFACT_AVAILABLE",
          "PRIOR_ARTIFACT_INVALID_OR_SUPERSEDED",
          "OPERATOR_REQUESTED_REPRODUCTION"
        ]
      }
    },
    "restage_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_same_run_duplication_is_not_by_itself_a_reason_to_repeat_operator_work",
        "restage_requires_recorded_invalidation_reason"
      ],
      "properties": {
        "missing_same_run_duplication_is_not_by_itself_a_reason_to_repeat_operator_work": {"const": true},
        "restage_requires_recorded_invalidation_reason": {"const": true}
      }
    },
    "allowed_restage_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "bindings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "required_markers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "path": {"type": "string", "minLength": 8},
          "required_markers": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 4}
          }
        }
      }
    },
    "proof_ceiling": {"type": "string", "minLength": 16}
  }
}
