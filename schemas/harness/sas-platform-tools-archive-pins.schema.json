{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/harness/sas-platform-tools-archive-pins.schema.json",
  "title": "SAS Platform-Tools Archive Pins",
  "description": "Independently reviewed immutable Google Platform-Tools archive pins for AndroidProvider prepare. Absence or blocked promotion fails closed; WinGet/post-download hashes alone never approve.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "pins"],
  "properties": {
    "schema_version": {"const": "sas-platform-tools-archive-pins/v1"},
    "catalog_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "pins": {
      "type": "array",
      "items": {"$ref": "#/$defs/pin"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "immutableGoogleUrl": {
      "type": "string",
      "pattern": "^https://dl\\.google\\.com/android/repository/platform-tools_r[0-9]+\\.[0-9]+\\.[0-9]+-win\\.zip$"
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "acquisition_url",
        "expected_archive_sha256",
        "approval_reference",
        "allowed_node_roles",
        "promotion_status"
      ],
      "properties": {
        "artifact_id": {"const": "android-platform-tools-windows"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "acquisition_url": {"$ref": "#/$defs/immutableGoogleUrl"},
        "expected_archive_sha256": {"$ref": "#/$defs/sha256"},
        "approval_reference": {"type": "string", "minLength": 1, "maxLength": 256},
        "allowed_node_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ptop_lab", "adminbox_reference", "technician_adminbox_field"]
          }
        },
        "promotion_status": {
          "enum": [
            "approved_for_provider_prepare",
            "blocked_pending_independent_sha256_pin",
            "superseded"
          ]
        },
        "acquisition_evidence": {
          "type": "string",
          "maxLength": 512,
          "description": "Sanitized informational pointer only; never sufficient without approved promotion_status and approval_reference."
        }
      }
    }
  }
}
