{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadminsuite.invalid/schemas/harness/deployment-state-registry.schema.json",
  "title": "SysAdminSuite deployment state registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "policy", "contexts"],
  "properties": {
    "schema_version": {"const": "sas-deployment-state-registry/v1"},
    "repository": {"const": "EndeavorEverlasting/SysAdminSuite"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolve_desired_state_before_commands",
        "tests_are_admission_not_target_state",
        "transport_live_cert_is_admission_only",
        "fixture_proof_is_admission_only",
        "do_not_reinstall_verified_core_apps",
        "runtime_only_does_not_imply_deployment_authority",
        "deploy_plus_runtime_requires_apply_first",
        "test_autologon_with_authorized_target_means_apply_pilot",
        "live_cert_with_autologon_or_cybernet_apply_intent_means_deployment_chain",
        "autologon_deployment_requires_restart",
        "runtime_proof_is_not_required_for_deployment_completion"
      ],
      "properties": {
        "resolve_desired_state_before_commands": {"const": true},
        "tests_are_admission_not_target_state": {"const": true},
        "transport_live_cert_is_admission_only": {"const": true},
        "fixture_proof_is_admission_only": {"const": true},
        "do_not_reinstall_verified_core_apps": {"const": true},
        "runtime_only_does_not_imply_deployment_authority": {"const": true},
        "deploy_plus_runtime_requires_apply_first": {"const": true},
        "test_autologon_with_authorized_target_means_apply_pilot": {"const": true},
        "live_cert_with_autologon_or_cybernet_apply_intent_means_deployment_chain": {"const": true},
        "autologon_deployment_requires_restart": {"const": true},
        "runtime_proof_is_not_required_for_deployment_completion": {"const": true}
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target_profile", "target_count", "package_sets", "current_product_truth", "intent_resolution", "states", "critical_artifact_chain", "forbidden_substitutions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "target_profile": {"type": "string", "minLength": 1},
          "target_count": {"type": "integer", "minimum": 1, "maximum": 25},
          "package_sets": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
          "current_product_truth": {"type": "object", "minProperties": 4, "additionalProperties": true},
          "intent_resolution": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "signals", "goal_state", "requires_apply", "notes"], "properties": {"id": {"type": "string"}, "signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}, "goal_state": {"type": "string", "minLength": 1}, "requires_apply": {"type": "boolean"}, "requires_prior_state": {"type": "string"}, "notes": {"type": "string", "minLength": 12}}, "additionalProperties": false}},
          "states": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "terminal"], "properties": {"id": {"type": "string", "minLength": 1}, "terminal": {"type": "boolean"}, "command_id": {"type": "string"}, "artifact_id": {"type": "string"}, "positive_classification": {"type": "string"}, "requires_state": {"type": "string"}, "requires_states": {"type": "array", "items": {"type": "string"}}, "ordering": {"type": "array", "items": {"type": "string"}}, "requires_target_mutation_authority": {"type": "boolean"}, "requires_network": {"type": "boolean"}, "requires_separate_attended_reboot": {"type": "boolean"}, "requires_direct_automatic_sign_in_observation": {"type": "boolean"}, "satisfied_by": {"type": "array", "items": {"type": "string"}}, "on_satisfied": {"type": "string"}, "on_unproven": {"type": "string"}, "proof_ceiling": {"type": "string"}}, "additionalProperties": false}},
          "critical_artifact_chain": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["artifact_id", "required_value", "proves_state"], "properties": {"artifact_id": {"type": "string"}, "required_value": {"type": "string"}, "proves_state": {"type": "string"}}, "additionalProperties": false}},
          "forbidden_substitutions": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}}
        }
      }
    }
  }
}
