{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadminsuite.invalid/schemas/harness/operator-execution-route-registry.schema.json",
  "title": "SysAdminSuite operator execution route registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "policy",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": "sas-operator-execution-route-registry/v1"
    },
    "repository": {
      "const": "EndeavorEverlasting/SysAdminSuite"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolve_execution_location_before_operator_command",
        "registered_front_door_overrides_inner_command_for_operator",
        "same_turn_execute_when_capability_exists",
        "otherwise_emit_one_route_and_run_command",
        "do_not_assume_current_directory",
        "do_not_require_operator_to_retype_repo_path",
        "propagate_child_exit_code",
        "fail_closed_when_location_or_entrypoint_is_unproven"
      ],
      "properties": {
        "resolve_execution_location_before_operator_command": {"const": true},
        "registered_front_door_overrides_inner_command_for_operator": {"const": true},
        "same_turn_execute_when_capability_exists": {"const": true},
        "otherwise_emit_one_route_and_run_command": {"const": true},
        "do_not_assume_current_directory": {"const": true},
        "do_not_require_operator_to_retype_repo_path": {"const": true},
        "propagate_child_exit_code": {"const": true},
        "fail_closed_when_location_or_entrypoint_is_unproven": {"const": true}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command_id",
          "platform",
          "required_network",
          "repository_freshness_dependency",
          "path_resolution",
          "operator_front_door",
          "inner_product_command",
          "operator_command_template",
          "success_artifact",
          "latest_pointer",
          "proof_ceiling"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command_id": {"type": "string", "minLength": 1},
          "platform": {"enum": ["windows-powershell"]},
          "required_network": {"type": "string", "minLength": 1},
          "repository_freshness_dependency": {"type": "string", "minLength": 1},
          "path_resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy_order",
              "installed_sas_probe",
              "cache_path",
              "required_files",
              "fail_closed"
            ],
            "properties": {
              "strategy_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "installed_sas_probe": {"type": "string", "minLength": 1},
              "cache_path": {"type": "string", "minLength": 1},
              "required_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "fail_closed": {"const": true}
            }
          },
          "operator_front_door": {"type": "string", "minLength": 1},
          "inner_product_command": {"type": "string", "minLength": 1},
          "operator_command_template": {"type": "string", "minLength": 1},
          "success_artifact": {"type": "string", "minLength": 1},
          "latest_pointer": {"type": "string", "minLength": 1},
          "proof_ceiling": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
