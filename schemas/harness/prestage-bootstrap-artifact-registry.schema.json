{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sysadminsuite/prestage-bootstrap-artifact-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "naming", "artifacts"],
  "properties": {
    "schema_version": {"const": "sas-prestage-bootstrap-artifact-registry/v1"},
    "repository": {"const": "EndeavorEverlasting/SysAdminSuite"},
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_report", "validation_result"],
      "properties": {
        "tracked_report": {"type": "string", "minLength": 1},
        "validation_result": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "generator", "format", "tracked", "contains_live_data", "purpose"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "generator": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "tracked": {"type": "boolean"},
          "contains_live_data": {"type": "boolean"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
