{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/harness/operator-communication-semantics.schema.json",
  "title": "SysAdminSuite operator communication semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "authority",
    "commitment_boundary",
    "regressions"
  ],
  "properties": {
    "schema_version": {
      "const": "sas-operator-communication-semantics/v1"
    },
    "schema_path": {
      "const": "schemas/harness/operator-communication-semantics.schema.json"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governance",
        "style_contract"
      ],
      "properties": {
        "governance": {
          "const": "AGENTS.md"
        },
        "style_contract": {
          "const": "docs/OPERATOR_COMMUNICATION_STYLE.md"
        }
      }
    },
    "commitment_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "classes"
      ],
      "properties": {
        "formula": {
          "const": "COMMITMENT_STRENGTH <= EVIDENCE_STRENGTH AND OPERATOR_CONTROL"
        },
        "classes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmed_fact",
            "expected_outcome",
            "internal_target",
            "contingency_buffer",
            "external_commitment"
          ],
          "properties": {
            "confirmed_fact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "external_mode"
              ],
              "properties": {
                "external_mode": {
                  "const": "allowed"
                }
              }
            },
            "expected_outcome": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "external_mode"
              ],
              "properties": {
                "external_mode": {
                  "const": "allowed_with_uncertainty"
                }
              }
            },
            "internal_target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "external_mode"
              ],
              "properties": {
                "external_mode": {
                  "const": "not_as_commitment"
                }
              }
            },
            "contingency_buffer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "external_mode"
              ],
              "properties": {
                "external_mode": {
                  "const": "omit_unless_relevant"
                }
              }
            },
            "external_commitment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "external_mode",
                "requires"
              ],
              "properties": {
                "external_mode": {
                  "const": "gated"
                },
                "requires": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "enum": [
                      "evidence_support",
                      "sufficient_operational_control",
                      "explicit_operator_intent"
                    ]
                  },
                  "allOf": [
                    {
                      "contains": {
                        "const": "evidence_support"
                      }
                    },
                    {
                      "contains": {
                        "const": "sufficient_operational_control"
                      }
                    },
                    {
                      "contains": {
                        "const": "explicit_operator_intent"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "regressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "facts",
          "client_allowed",
          "client_forbidden",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "delivery_window",
              "internal_technician_target"
            ],
            "properties": {
              "delivery_window": {
                "type": "string",
                "minLength": 1
              },
              "internal_technician_target": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "client_allowed": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "client_forbidden": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
