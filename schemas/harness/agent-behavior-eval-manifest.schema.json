{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sas-agent-behavior-eval-manifest/v1",
  "title": "SysAdminSuite Agent Behavior Eval Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "suite_id",
    "purpose",
    "case_set",
    "runner",
    "baseline_response_set",
    "reference_response_set",
    "judge_rubric",
    "threshold_change_ledger",
    "thresholds",
    "outcome_policy",
    "eval_pyramid",
    "report_artifacts",
    "known_failure_sources"
  ],
  "properties": {
    "schema_version": {
      "const": "sas-agent-behavior-eval-manifest/v1"
    },
    "schema_path": {
      "const": "schemas/harness/agent-behavior-eval-manifest.schema.json"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "case_set": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "baseline_response_set": {
      "type": "string",
      "minLength": 1
    },
    "reference_response_set": {
      "type": "string",
      "minLength": 1
    },
    "judge_rubric": {
      "type": "string",
      "minLength": 1
    },
    "threshold_change_ledger": {
      "type": "string",
      "minLength": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_required_score",
        "critical_failures_allowed",
        "baseline_must_fail",
        "reference_candidate_must_pass"
      ],
      "properties": {
        "deterministic_required_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critical_failures_allowed": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_must_fail": {
          "const": true
        },
        "reference_candidate_must_pass": {
          "const": true
        }
      }
    },
    "outcome_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "acceptable_degradation",
        "failure"
      ],
      "properties": {
        "success": {
          "type": "string",
          "minLength": 1
        },
        "acceptable_degradation": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "eval_pyramid": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "use_when",
          "model_tokens_allowed"
        ],
        "properties": {
          "layer": {
            "enum": [
              "deterministic",
              "synthetic_integration",
              "model_judge",
              "human_review"
            ]
          },
          "use_when": {
            "type": "string",
            "minLength": 1
          },
          "model_tokens_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "report_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate",
        "schema_version"
      ],
      "properties": {
        "baseline": {
          "type": "string"
        },
        "candidate": {
          "type": "string"
        },
        "schema_version": {
          "const": "sas-agent-behavior-eval-result/v1"
        }
      }
    },
    "known_failure_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "failure_class"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "failure_class": {
            "type": "string"
          }
        }
      }
    }
  }
}
