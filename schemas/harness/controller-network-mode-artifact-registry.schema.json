{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sysadminsuite.local/harness/controller-network-mode-artifact-registry.schema.json",
  "title": "SysAdminSuite controller network-mode artifact registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "schema", "naming", "artifacts"],
  "properties": {
    "schema_version": {"const": "sas-controller-network-mode-artifact-registry/v1"},
    "repository": {"type": "string", "minLength": 1},
    "schema": {"type": "string", "minLength": 1},
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_report", "runtime_certification", "network_evidence"],
      "properties": {
        "tracked_report": {"type": "string", "minLength": 1},
        "runtime_certification": {"type": "string", "minLength": 1},
        "network_evidence": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "generator", "tracked", "purpose"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "generator": {"type": "string", "minLength": 1},
          "tracked": {"type": "boolean"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
