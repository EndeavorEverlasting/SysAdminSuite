{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/SysAdminSuite/schemas/harness/cybernet-device-exclusion-registry.schema.json",
  "title": "SysAdminSuite Cybernet Device Exclusion Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "purpose",
    "tracking_policy",
    "decision_policy",
    "evidence_strengths",
    "evidence_types",
    "device_classes",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "sas-cybernet-device-exclusion-registry/v1"
    },
    "repository": {
      "const": "EndeavorEverlasting/SysAdminSuite"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "tracking_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked_registry_contains_live_entries",
        "live_entry_tracking",
        "live_entry_default_path"
      ],
      "properties": {
        "tracked_registry_contains_live_entries": {
          "const": false
        },
        "live_entry_tracking": {
          "const": "local_untracked_or_approved_external_source"
        },
        "live_entry_default_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_action",
        "conflict_action",
        "positive_cybernet_evidence_action",
        "before_network_signature_requires",
        "before_endpoint_metadata_requires",
        "before_hardware_metadata_allows",
        "weak_evidence_never_accumulates_to_reject",
        "corroborating_evidence_never_accumulates_to_reject",
        "strong_evidence_never_accumulates_to_reject_without_authority",
        "hostname_alone_can_reject",
        "software_presence_or_absence_can_reject",
        "subnet_alone_can_reject",
        "open_ports_alone_can_reject",
        "mac_oui_alone_can_reject",
        "network_signature_alone_can_reject",
        "new_active_query_for_exclusion_allowed"
      ],
      "properties": {
        "default_action": {
          "const": "DO_NOT_EXCLUDE"
        },
        "conflict_action": {
          "const": "REVIEW_REQUIRED_NO_AUTO_EXCLUSION"
        },
        "positive_cybernet_evidence_action": {
          "const": "BLOCK_EXCLUSION_AND_ROUTE_TO_HARDWARE_IDENTITY"
        },
        "before_network_signature_requires": {
          "const": "AUTHORITATIVE_NON_CYBERNET_CLASSIFICATION"
        },
        "before_endpoint_metadata_requires": {
          "const": "AUTHORITATIVE_NON_CYBERNET_CLASSIFICATION"
        },
        "before_hardware_metadata_allows": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AUTHORITATIVE_NON_CYBERNET_CLASSIFICATION",
              "CURRENT_WINDOWS_NON_CLIENT_PRODUCT_TYPE"
            ]
          }
        },
        "weak_evidence_never_accumulates_to_reject": {
          "const": true
        },
        "corroborating_evidence_never_accumulates_to_reject": {
          "const": true
        },
        "strong_evidence_never_accumulates_to_reject_without_authority": {
          "const": true
        },
        "hostname_alone_can_reject": {
          "const": false
        },
        "software_presence_or_absence_can_reject": {
          "const": false
        },
        "subnet_alone_can_reject": {
          "const": false
        },
        "open_ports_alone_can_reject": {
          "const": false
        },
        "mac_oui_alone_can_reject": {
          "const": false
        },
        "network_signature_alone_can_reject": {
          "const": false
        },
        "new_active_query_for_exclusion_allowed": {
          "const": false
        }
      }
    },
    "evidence_strengths": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "auto_rejection_eligible",
          "meaning"
        ],
        "properties": {
          "id": {
            "enum": [
              "AUTHORITATIVE",
              "STRONG",
              "CORROBORATING",
              "WEAK",
              "CONFLICTING"
            ]
          },
          "auto_rejection_eligible": {
            "type": "boolean"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "strength",
          "source_family",
          "collection_policy",
          "auto_rejection_stages",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "strength": {
            "enum": [
              "AUTHORITATIVE",
              "STRONG",
              "CORROBORATING",
              "WEAK",
              "CONFLICTING"
            ]
          },
          "source_family": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "collection_policy": {
            "enum": [
              "REUSE_EXISTING_ONLY",
              "REUSE_ONLY_NO_NEW_QUERY_FOR_EXCLUSION",
              "EXISTING_REQUIRED_GATE_ONLY"
            ]
          },
          "auto_rejection_stages": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "BEFORE_NETWORK_SIGNATURE",
                "BEFORE_ENDPOINT_METADATA",
                "BEFORE_HARDWARE_METADATA"
              ]
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "device_classes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "aliases",
          "safe_pre_query_evidence_types",
          "safe_pre_hardware_evidence_types",
          "never_sufficient_evidence_types"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "safe_pre_query_evidence_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "safe_pre_hardware_evidence_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "never_sufficient_evidence_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "device_class",
          "stable_device_key",
          "evidence",
          "decision"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "device_class": {
            "type": "string",
            "minLength": 1
          },
          "stable_device_key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "serial",
                  "asset_id",
                  "mac",
                  "controller_id",
                  "cmdb_ci",
                  "other_approved_stable_key"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_type",
                "source_reference",
                "observed_at"
              ],
              "properties": {
                "evidence_type": {
                  "type": "string",
                  "minLength": 1
                },
                "source_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason_codes",
              "evaluated_at"
            ],
            "properties": {
              "status": {
                "enum": [
                  "DO_NOT_EXCLUDE",
                  "REVIEW_REQUIRED_NO_AUTO_EXCLUSION",
                  "EXCLUDED_BEFORE_NETWORK_SIGNATURE",
                  "EXCLUDED_BEFORE_ENDPOINT_METADATA",
                  "EXCLUDED_BEFORE_HARDWARE_METADATA"
                ]
              },
              "reason_codes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evaluated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
