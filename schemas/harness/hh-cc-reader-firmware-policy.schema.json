{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadminsuite.invalid/schemas/harness/hh-cc-reader-firmware-policy.schema.json",
  "title": "H&H CC reader firmware decision policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "scope",
    "source_field_semantics",
    "site_resolution",
    "observed_client_accepted_candidates",
    "selection",
    "ambiguities",
    "mechanism_discovery",
    "gates",
    "proven_path_acceptance",
    "readonly_estate_checklist",
    "bindings",
    "proof_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "sas-hh-cc-reader-firmware-policy/v1"
    },
    "repository": {
      "const": "EndeavorEverlasting/SysAdminSuite"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "device_family",
        "source_field",
        "source_authority"
      ],
      "properties": {
        "organization": {
          "const": "NYC Health + Hospitals"
        },
        "device_family": {
          "const": "PAX A80"
        },
        "source_field": {
          "const": "Active Outdated"
        },
        "source_authority": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "source_field_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yes",
        "no",
        "authority_ceiling"
      ],
      "properties": {
        "yes": {
          "type": "string",
          "minLength": 16
        },
        "no": {
          "type": "string",
          "minLength": 16
        },
        "authority_ceiling": {
          "type": "string",
          "minLength": 24
        }
      }
    },
    "observed_client_accepted_candidates": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "basis",
          "status",
          "ambiguity"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)+$"
          },
          "basis": {
            "type": "string",
            "minLength": 16
          },
          "status": {
            "enum": [
              "accepted_candidate",
              "default_target_candidate"
            ]
          },
          "ambiguity": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 16
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_target",
        "scope",
        "rule",
        "ordering",
        "rationale",
        "supersession_requires"
      ],
      "properties": {
        "default_target": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)+$"
        },
        "rule": {
          "const": "highest_numeric_observed_client_accepted_candidate"
        },
        "ordering": {
          "type": "string",
          "minLength": 16
        },
        "rationale": {
          "type": "string",
          "minLength": 24
        },
        "supersession_requires": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 16
          }
        },
        "scope": {
          "const": "fleet_planning_candidate_only"
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "state",
          "question",
          "handling"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)+$"
          },
          "state": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 16
          },
          "handling": {
            "type": "string",
            "minLength": 24
          }
        }
      }
    },
    "mechanism_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "human_escalation",
        "required_dispositions",
        "candidate_order",
        "rules"
      ],
      "properties": {
        "strategy": {
          "const": "mechanism_first_before_human_escalation"
        },
        "human_escalation": {
          "type": "string",
          "minLength": 32
        },
        "required_dispositions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PROVEN_PATH",
              "NOT_APPLICABLE",
              "CREDENTIAL_GATE",
              "EVIDENCE_GAP"
            ]
          }
        },
        "candidate_order": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "priority",
              "evidence_rank",
              "disposition",
              "evidence_basis",
              "next_discriminator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]+$"
              },
              "role": {
                "enum": [
                  "estate_management_surface",
                  "firmware_delivery_mechanism",
                  "provider_specific_fallback"
                ]
              },
              "priority": {
                "type": "integer",
                "minimum": 1
              },
              "evidence_basis": {
                "type": "string",
                "minLength": 32
              },
              "next_discriminator": {
                "type": "string",
                "minLength": 32
              },
              "evidence_rank": {
                "enum": [
                  "STRONGEST_ESTATE_MATCH",
                  "STRONGEST_DELIVERY_MATCH",
                  "FALLBACK"
                ]
              },
              "disposition": {
                "enum": [
                  "PROVEN_PATH",
                  "NOT_APPLICABLE",
                  "CREDENTIAL_GATE",
                  "EVIDENCE_GAP"
                ]
              }
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "management_surface_and_delivery_mechanism_are_separate_discriminators",
            "exhaust_supported_mechanisms_before_human_escalation",
            "human_owner_confirmation_is_not_a_primary_discriminator",
            "credential_gate_names_exact_surface_and_missing_access",
            "do_not_mutate_reader_to_discover_management_path"
          ],
          "properties": {
            "management_surface_and_delivery_mechanism_are_separate_discriminators": {
              "const": true
            },
            "exhaust_supported_mechanisms_before_human_escalation": {
              "const": true
            },
            "human_owner_confirmation_is_not_a_primary_discriminator": {
              "const": true
            },
            "credential_gate_names_exact_surface_and_missing_access": {
              "const": true
            },
            "do_not_mutate_reader_to_discover_management_path": {
              "const": true
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "do_not_treat_active_outdated_no_as_vendor_latest",
        "do_not_silently_substitute_target",
        "authoritative_package_mapping_required_before_firmware_mutation",
        "supported_update_method_required_before_firmware_mutation",
        "controlled_pilot_required_before_repeatable_rollout",
        "site_context_required_before_firmware_mutation",
        "fleet_default_is_not_site_execution_authority"
      ],
      "properties": {
        "do_not_treat_active_outdated_no_as_vendor_latest": {
          "const": true
        },
        "do_not_silently_substitute_target": {
          "const": true
        },
        "authoritative_package_mapping_required_before_firmware_mutation": {
          "const": true
        },
        "supported_update_method_required_before_firmware_mutation": {
          "const": true
        },
        "controlled_pilot_required_before_repeatable_rollout": {
          "const": true
        },
        "site_context_required_before_firmware_mutation": {
          "const": true
        },
        "fleet_default_is_not_site_execution_authority": {
          "const": true
        }
      }
    },
    "proven_path_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "from_disposition",
        "to_disposition",
        "eligible_mechanism_ids",
        "ineligible_mechanism_ids",
        "required_access_state",
        "required_packet_fields",
        "rules",
        "acceptance_record_fields",
        "completion_gate",
        "proof_ceiling"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 32
        },
        "from_disposition": {
          "const": "CREDENTIAL_GATE"
        },
        "to_disposition": {
          "const": "PROVEN_PATH"
        },
        "eligible_mechanism_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          }
        },
        "ineligible_mechanism_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          }
        },
        "required_access_state": {
          "const": "PROVEN_ACCESS"
        },
        "required_packet_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorized_readonly_session_required",
            "representative_terminal_must_be_bound",
            "current_firmware_must_be_observed",
            "current_firmware_value_must_be_recorded",
            "all_seven_packet_fields_must_be_answered",
            "unknown_without_reason_fails_closed",
            "package_absence_is_conflict_not_silent_substitution",
            "package_visibility_unknown_cannot_promote",
            "mutation_remains_unauthorized_after_proven_path",
            "discovery_must_not_push_assign_activate_approve_reset_or_change",
            "p6_pilot_remains_separately_authorized"
          ],
          "properties": {
            "authorized_readonly_session_required": {
              "const": true
            },
            "representative_terminal_must_be_bound": {
              "const": true
            },
            "current_firmware_must_be_observed": {
              "const": true
            },
            "current_firmware_value_must_be_recorded": {
              "const": true
            },
            "all_seven_packet_fields_must_be_answered": {
              "const": true
            },
            "unknown_without_reason_fails_closed": {
              "const": true
            },
            "package_absence_is_conflict_not_silent_substitution": {
              "const": true
            },
            "package_visibility_unknown_cannot_promote": {
              "const": true
            },
            "mutation_remains_unauthorized_after_proven_path": {
              "const": true
            },
            "discovery_must_not_push_assign_activate_approve_reset_or_change": {
              "const": true
            },
            "p6_pilot_remains_separately_authorized": {
              "const": true
            }
          }
        },
        "acceptance_record_fields": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "completion_gate": {
          "type": "string",
          "minLength": 64
        },
        "proof_ceiling": {
          "type": "string",
          "minLength": 32
        }
      }
    },
    "readonly_estate_checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "lane",
        "forbidden_actions",
        "minimum_role_by_surface",
        "items"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 32
        },
        "lane": {
          "const": "P5_management_plane_discovery"
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "minimum_role_by_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payment-fusion-control-center",
            "paxstore-ota-push",
            "provider-auto-update"
          ],
          "properties": {
            "payment-fusion-control-center": {
              "type": "string",
              "minLength": 24
            },
            "paxstore-ota-push": {
              "type": "string",
              "minLength": 16
            },
            "provider-auto-update": {
              "type": "string",
              "minLength": 24
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "required",
              "observation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]+$"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "required": {
                "const": true
              },
              "observation": {
                "type": "string",
                "minLength": 24
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "required_markers"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 8
          },
          "required_markers": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 4
            }
          }
        }
      }
    },
    "proof_ceiling": {
      "type": "string",
      "minLength": 32
    },
    "site_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fleet_planning_scope",
        "default_site_state",
        "execution_target_state",
        "rules",
        "resolution_evidence"
      ],
      "properties": {
        "fleet_planning_scope": {
          "const": "organization-wide candidate only"
        },
        "default_site_state": {
          "const": "DISCOVERY_REQUIRED"
        },
        "execution_target_state": {
          "const": "UNRESOLVED_UNTIL_SITE_AND_MANAGEMENT_AUTHORITY"
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization_default_is_not_site_execution_authority",
            "site_or_hospital_context_required_before_mutation_behavior",
            "independently_operated_or_unproved_site_requires_explicit_site_evidence",
            "unknown_ambiguous_conflicting_or_unsupported_site_fails_closed"
          ],
          "properties": {
            "organization_default_is_not_site_execution_authority": {
              "const": true
            },
            "site_or_hospital_context_required_before_mutation_behavior": {
              "const": true
            },
            "independently_operated_or_unproved_site_requires_explicit_site_evidence": {
              "const": true
            },
            "unknown_ambiguous_conflicting_or_unsupported_site_fails_closed": {
              "const": true
            }
          }
        },
        "resolution_evidence": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 24
          }
        }
      }
    }
  }
}
