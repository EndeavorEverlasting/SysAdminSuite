{
  "schema_version": "sas-cybernet-client-preferences/v1",
  "profile_id": "cybernet-clinical-workstation-default",
  "display_name": "Cybernet clinical workstation client preferences",
  "target_identity": {
    "operator_input": "short_hostname_or_fqdn",
    "canonical_transport_identity": "unique_dns_fqdn",
    "resolution_sources": [
      "controller_dns_search",
      "windows_suffix_search_list",
      "active_adapter_connection_suffix",
      "user_dns_domain",
      "ip_global_properties_domain",
      "SAS_TARGET_DNS_SUFFIXES"
    ],
    "unresolved_policy": "fail_closed",
    "ambiguous_policy": "fail_closed",
    "canonical_name_mismatch_policy": "fail_closed",
    "manual_domain_append_forbidden": true,
    "tracked_internal_dns_suffix_forbidden": true
  },
  "hardware": {
    "standby_ac_minutes": 0,
    "standby_dc_minutes": 0,
    "hibernate_ac_minutes": 0,
    "hibernate_dc_minutes": 0,
    "physical_power_button_action": "do_nothing",
    "display_button_control": {
      "protocol": "MCCS_2_2_DDCCI",
      "vcp_code": "0xCA",
      "desired_value": "0x0303",
      "meaning": "disable OSD/Menu button events and display power-button events"
    },
    "ready_com_ports": [
      "COM1",
      "COM2",
      "COM3",
      "COM4"
    ],
    "repairable_com_ports": [
      "COM3",
      "COM4",
      "COM5",
      "COM6"
    ],
    "com_repair_policy": "local_only_existing_autofix_with_reboot_gate"
  },
  "software": {
    "package_set_id": "cybernet-clinical-workstation",
    "package_count": 6,
    "package_ids": [
      "allscripts-eehr-shortcut-uai-2-2",
      "epic-downtime-guide-shortcut-1-0",
      "nuance-dragon-medical-one-2025",
      "hyland-fos-epic-integration-23-1-33-1000",
      "bca",
      "autologon"
    ],
    "autologon_must_be_last": true,
    "software_acceptance_required": true,
    "restart_policy": "separately_authorized_only",
    "deployment_lanes": {
      "full_profile": {
        "package_set_id": "cybernet-clinical-workstation",
        "autologon_behavior": "final_separate_mutating_step",
        "profile_capture": "supported"
      },
      "profiled_clinical_core": {
        "package_set_id": "cybernet-clinical-core",
        "package_count": 5,
        "autologon_behavior": "observe_only_do_not_enable_disable_or_repair",
        "automatic_reboot": false,
        "runtime_dependencies": [
          "windows_powershell_5_1_or_newer"
        ],
        "git_bash_required": false,
        "python_required": false,
        "profile_capture": "required_before_and_after"
      }
    },
    "conditional_observations": {
      "imprivata": {
        "presence": "conditional_external_state",
        "managed_by_sysadminsuite_clinical_core": false,
        "package_membership": "none",
        "capture_before_and_after": true,
        "comparison_fields": [
          "installed_display_names",
          "services",
          "service_status",
          "service_start_type"
        ],
        "interpretation": "Imprivata may already be pushed/configured by another management lane. Its observed state must be retained in Cybernet profile evidence without treating it as a clinical-core install, removal, configuration, or completion requirement."
      },
      "autologon": {
        "capture_before_and_after": true,
        "core_lane_mutation": "forbidden",
        "comparison_fields": [
          "AutoAdminLogon",
          "enabled"
        ],
        "interpretation": "The profiled clinical-core lane preserves the current AutoLogon state. AutoLogon enablement or repair belongs only to its separately authorized final lane."
      }
    }
  },
  "workflow": {
    "pilot_target_count": 1,
    "maximum_target_count": 25,
    "apply_order": [
      "hardware_apply_and_validate",
      "approved_software_package_set_install",
      "hardware_post_software_validate",
      "technician_software_acceptance"
    ],
    "credentials_in_command_forbidden": true,
    "automatic_reboot_forbidden": true,
    "live_evidence_in_git_forbidden": true
  }
}
